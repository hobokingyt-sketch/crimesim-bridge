{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrimeSim Bridge",
  "version": "0.2.5",
  "identifier": "com.zeno.crimesimbridge",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CrimeSim Bridge",
        "width": 1040,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Transactional bridge between ChatGPT update packs and Godot projects",
    "resources": [
      "resources/godot/**/*"
    ]
  }
}
